# 32-byte pre-shared key, base64url. Generate one with: antibrow-relay keygen
FP_RELAY_KEY=

# Guards /admin. Leave empty and the whole admin surface answers 404.
ADMIN_KEY=

# Set to 1 to also serve the unencrypted protocol. It puts target hostnames on
# the wire in clear text, so it is off unless you turn it on deliberately.
ALLOW_PLAINTEXT=0

PORT=8899

# Defaults to ./relay.db (relative to the working directory) when unset. The
# Docker image sets its own default of /data/relay.db and does not need this
# line; the systemd unit needs an explicit path inside its ReadWritePaths
# (see docs/DEPLOY.md). Uncomment and set a path for your deployment:
# DB_PATH=/data/relay.db
